{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-care1"
		},
		"ls_AzureDatabricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1023-141733-ldqk95ej"
		},
		"ls_adls_care_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://strgcicare.dfs.core.windows.net/"
		},
		"ls_az_sql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "dp700-fabric.database.windows.net"
		},
		"ls_az_sql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "free-sql-db-5378250"
		},
		"ls_az_sql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "radhakrishna"
		},
		"ls_key_vault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://care-kv-1.vault.azure.net/"
		},
		"ls_postgres_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-lingering-smoke-a14wq8nd-pooler.ap-southeast-1.aws.neon.tech"
		},
		"ls_postgres_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"ls_postgres_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-care1_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_care_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_care_properties_typeProperties_url')]"
					},
					"ls_key_vault_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_key_vault_properties_typeProperties_baseUrl')]"
					},
					"ls_AzureDatabricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_AzureDatabricks_properties_typeProperties_existingClusterId')]"
					},
					"ls_az_sql_properties_typeProperties_server": {
						"value": "[parameters('ls_az_sql_properties_typeProperties_server')]"
					},
					"ls_az_sql_properties_typeProperties_database": {
						"value": "[parameters('ls_az_sql_properties_typeProperties_database')]"
					},
					"ls_az_sql_properties_typeProperties_userName": {
						"value": "[parameters('ls_az_sql_properties_typeProperties_userName')]"
					},
					"ls_postgres_properties_typeProperties_server": {
						"value": "[parameters('ls_postgres_properties_typeProperties_server')]"
					},
					"ls_postgres_properties_typeProperties_database": {
						"value": "[parameters('ls_postgres_properties_typeProperties_database')]"
					},
					"ls_postgres_properties_typeProperties_username": {
						"value": "[parameters('ls_postgres_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}